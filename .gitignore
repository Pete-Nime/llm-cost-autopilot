
# Never upload our private API credentials
.env
.env.*

# Allow the safe example file
!.env.example

# Ignore Python virtual environments
.venv/

# Ignore generated Python files
__pycache__/
*.pyc
.pytest_cache/

# Ignore generated benchmark reports.
reports/

# Ignore local SQLite database files.
*.db
*.db-shm
*.db-wal
